/* Credits to Newman Sanchez (https://github.com/newmanls) */

@import "../../theme/generated/colors.rasi"

configuration {
  show-icons: true;
  sort: true;
  display-drun: "󰀻 ";
  display-run: "󰜎 ";
  display-window: " ";
  display-ssh: " ";
  display-combi: "Comb";
  display-keys: "Keys";
  display-filebrowser: "FB  ";
  display-qalc: " ";
  combi-modes: [window,drun];
}

* {
    font:   "JetBrainsMono Nerd Font 10";

    background-color:   transparent;
    text-color:         @fg;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       center;
    width:          600;
    border-radius:  10px;

    background-color:   @rofi-bg;
    border: 2px;
    border-color: @rofi-border;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @rofi-bg;
    border-color:       @selected-bg;

    border:         0 0 2px 0;
    border-radius:  10px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg;
}

entry {
    // placeholder:        "Search";
    placeholder-color:  @black-bright;
    horizontal-align: 0.47;
    cursor: text;
}

// This is the frecency box that appears in rofimoji
message {
    margin:             12px 0 0 0;
    border-radius:      10px;
    border-color:       @rofi-border;
    background-color:   @rofi-bg;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     12px 0 0;
    lines:      12;
    columns:    2;

    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  10px;
}

element normal active {
    text-color: @active-fg;
}

element alternate active {
    text-color: @active-fg;
}

element selected normal, element selected active {
    background-color:   @selected-bg;
    text-color:         @white;
    border-radius:      10px;
    border:             1px;
    border-color:       @rofi-border;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
