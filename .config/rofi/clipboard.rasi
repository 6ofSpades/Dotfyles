
@import "~/.config/rofi/config.rasi"

// ------------------------------------------------------------------
/* ---- Configuration ---- */ 

window {
  width: 40%;
}

/* ---- Mainbox ---- */

entry {
  expand: true;
  placeholder: "Search clipboard";
  horizontal-align: 0.4;
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 6;
  flow: horizontal;
  fixed-width: true;
  cycle: true;
}

/* ---- Element ---- */
element {
  orientation: horizontal;
  padding: 0px;
  spacing: 0px;
  margin: 0px;
  border-radius: 10px;
}

element-icon {
  vertical-align:     0.5;
  horizontal-align:   0.5;
  padding:            2px;
  text-color:         inherit;
  size:               5%;
  cursor:             inherit;
}

element selected.normal {
  background-color:   @bg3;
  border-radius:      10px;
  padding:            2px;
}

element-text {
  vertical-align: 0.5;
  horizontal-align: 0;
  padding: 0 10px 0 0;
}
