#!/bin/bash

if [[ "$1" == opacityp ]]; then
  opacity=$(hyprctl getprop active opacity)
  if [[ $(echo "$opacity < 1" | bc -l) -eq 1 ]]; then
    new_op=$(echo "$opacity + 0.1" | bc)
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity', value = '$new_op' })"
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity_inactive', value = '$new_op' })"
    exit 0
  fi
fi

if [[ "$1" == opacitym ]]; then
  opacity=$(hyprctl getprop active opacity)
  if [[ $(echo "$opacity > 0" | bc -l) -eq 1 ]]; then
    new_op=$(echo "$opacity - 0.1" | bc)
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity', value = '$new_op' })"
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity_inactive', value = '$new_op' })"
    exit 0
  fi
fi

if [[ "$1" == blur ]]; then
  if $(hyprctl getprop active no_blur); then
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'no_blur', value = 0 })"
  else
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'no_blur', value = 1 })"
  fi
  exit 0
fi

if [[ "$1" == blur-all ]]; then
  # Safely extract option value, defaulting to an empty string if it fails
  blur_status=$(hyprctl getoption decoration:blur:enabled |
    awk '/^bool:/ {print $2}')

  case "$blur_status" in
  true)
    hyprctl eval 'hl.config({ decoration = { blur = { enabled = false } } })'
    ;;
  false)
    hyprctl eval 'hl.config({ decoration = { blur = { enabled = true } } })'
    ;;
  *)
    echo "Unexpected output: $blur_status"
    ;;
  esac
  exit 0
fi

if [[ "$1" == resize-percent ]]; then
  percent="$2"

  # Ctrl+0 = 100%
  if [[ "$percent" == "0" ]]; then
    percent=100
  fi

  # Get the focused monitor dimensions
  monitor_width=$(hyprctl monitors -j | jq -r '
    .[] | select(.focused == true) | .width
  ')

  monitor_height=$(hyprctl monitors -j | jq -r '
    .[] | select(.focused == true) | .height
  ')

  # Get current active window dimensions
  current_width=$(hyprctl activewindow -j | jq -r '.size[0]')
  current_height=$(hyprctl activewindow -j | jq -r '.size[1]')

  # Calculate target dimensions
  target_width=$((monitor_width * percent / 100))
  target_height=$((monitor_height * percent / 100))

  # Calculate resize delta
  delta_width=$((target_width - current_width))
  delta_height=$((target_height - current_height))

  # Use the Lua dispatcher API
  hyprctl dispatch "hl.dsp.window.resize({ x = $delta_width, y = $delta_height, relative = true })"

  # and center the window
  hyprctl dispatch "hl.dsp.window.center()"

  exit 0
fi
