#!/bin/bash

if [[ "$1" == opacityp ]]; then
  opacity=$(hyprctl getprop active opacity)
  if [[ $(echo "$opacity < 1" | bc -l) -eq 1 ]]; then
    new_op=$(echo "$opacity + 0.1" | bc)
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity', value = '$new_op' })"
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity_inactive', value = '$new_op' })"
    exit 0
  fi
fi

if [[ "$1" == opacitym ]]; then
  opacity=$(hyprctl getprop active opacity)
  if [[ $(echo "$opacity > 0" | bc -l) -eq 1 ]]; then
    new_op=$(echo "$opacity - 0.1" | bc)
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity', value = '$new_op' })"
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'opacity_inactive', value = '$new_op' })"
    exit 0
  fi
fi

if [[ "$1" == blur ]]; then
  if $(hyprctl getprop active no_blur); then
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'no_blur', value = 0 })"
  else
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = 'no_blur', value = 1 })"
  fi
  exit 0
fi

if [[ "$1" == blur-all ]]; then
  # Safely extract option value, defaulting to an empty string if it fails
  blur_status=$(hyprctl getoption decoration:blur:enabled |
    awk '/^bool:/ {print $2}')

  case "$blur_status" in
  true)
    hyprctl eval 'hl.config({ decoration = { blur = { enabled = false } } })'
    ;;
  false)
    hyprctl eval 'hl.config({ decoration = { blur = { enabled = true } } })'
    ;;
  *)
    echo "Unexpected output: $blur_status"
    ;;
  esac
  exit 0
fi
