#!/bin/bash

TEMP="/tmp/mark-cursor"
POP="$HOME/.config/hypr/scripts/.pop-alert.mp3"
SWOOSH="$HOME/.config/hypr/scripts/.operagx-swoosh.mp3"

# Create temporary file if it doesn't exist
if [[ ! -e $TEMP ]]; then
  touch $TEMP
fi

function mark {
  echo $(hyprctl cursorpos) >$TEMP
  paplay $POP
}

function move {
  pos="$(<$TEMP)"

  [[ -z $pos ]] && notify-send -a Cursor-Mark "There is no mark" -t 1000 -i script-error && exit 1

  pos=$(echo $pos | tr -d ',')

  ydotool mousemove -a $pos

  paplay $SWOOSH
}

case $1 in
mark) mark ;;
move) move ;;
esac
