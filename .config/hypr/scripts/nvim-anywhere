#!/bin/bash

# set -eo pipefail

# ==========================================
# CONFIGURATION
# ==========================================
TERM_CLASS="nvim-anywhere"
TERM_EXEC="kitty"
TMPFILE_DIR="/tmp/nvim-anywhere"
NVIM_CONFIG_DIR="$HOME/.config/nvim-anywhere"

TERM_OPTS=(
  -o "confirm_os_window_close=0"
  -o "background_opacity=0.5"
  -o "background=#000000"
  --class "$TERM_CLASS"
  -e
)

# ==========================================
# FUNCTIONS
# ==========================================

kill_existing_instance() {
  local address
  address=$(hyprctl -j clients | jq -r ".[] | select(.class == \"$TERM_CLASS\") | .address" | head -n1)

  if [[ -n "$address" ]]; then
    hyprctl dispatch "hl.dsp.window.close({ window = 'address:$address' })"
    rm -rf "$TMPFILE_DIR"/*
    echo "Existing instance closed."
    exit 0
  fi
}

# ==========================================
# MAIN EXECUTION
# ==========================================

kill_existing_instance

# Create temp file
mkdir -p "$TMPFILE_DIR"
TMPFILE="$TMPFILE_DIR/doc-$(date +"%y%m%d%H%M%S")"
touch "$TMPFILE"
chmod og-rwx "$TMPFILE"

# Save active window address before opening nvim
PREV_WINDOW=$(hyprctl -j activewindow | jq -r '.address')

# Launch Neovim
$TERM_EXEC "${TERM_OPTS[@]}" env NVIM_APPNAME=nvim-anywhere nvim \
  +startinsert \
  -i NONE -n \
  "$TMPFILE" \
  -u "$NVIM_CONFIG_DIR/init.lua" 63<&0 0</dev/null

# ONLY refocus and paste if the file actually has content
if [[ -s "$TMPFILE" ]]; then
  if [[ -n "$PREV_WINDOW" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$PREV_WINDOW' })"
  fi
  wl-copy -n <"$TMPFILE"
  wtype -M Ctrl -k v -m Ctrl
fi

# Cleanup
rm -f "$TMPFILE"
