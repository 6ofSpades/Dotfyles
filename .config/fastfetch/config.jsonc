{
  "$schema": "https:#github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2
    },
    "color": {
      "1": "#303aff",
      "2": "#303aff"
    },
    "source": "~/.config/fastfetch/logos/tarot-sun-moon.txt"
  },
  "display": {
    "separator": " \u2192 ",
    "color": {
      "title": "#cc00fc",
      "keys": "#8500bc",
      "separator": "#414a74",
      "output": "#c0caf5"
    },
    "percent": {
      "type": 2,
      "color": {
        "green": "#00ffff",
        "yellow": "#303aff",
        "red": "#8500bc"
      }
    }
  },
  "modules": [
    {
      "type": "break"
    },
    {
      "type": "title",
      "color": {
        "user": "#8500bc",
        "at": "#00ffff",
        "host": "#8500bc"
      }
    },
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500 OS Info \u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "#303aff"
    },
    {
      "type": "os",
      "key": " \uf303 "
    },
    {
      "type": "kernel",
      "key": " \uebc6 "
    },
    {
      "type": "packages",
      "key": " \uf487 "
    },
    {
      "type": "shell",
      "key": " \uf120 "
    },
    {
      "type": "wm",
      "key": " \uf488 "
    },
    {
      "type": "terminal",
      "key": " \uf489 "
    },
    {
      "type": "terminalfont",
      "key": " \uf031 "
    },
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500 Hardware Info \u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "#303aff"
    },
    {
      "type": "display",
      "key": " \udb80\udf79 "
    },
    {
      "type": "cpu",
      "key": " \uf4bc "
    },
    {
      "type": "gpu",
      "key": " \uf4bc "
    },
    {
      "type": "memory",
      "key": " \uefc5 "
    },
    {
      "type": "disk",
      "key": " \uf0a0 "
    },
    {
      "type": "custom",
      "key": " ",
      "format": " "
    },
    {
      "type": "localip",
      "key": " \uef09 "
    },
    {
      "type": "uptime",
      "key": " \uf017 "
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": " \u001b[90m\uf192   \u001b[31m\uf192   \u001b[32m\uf192   \u001b[33m\uf192   \u001b[34m\uf192   \u001b[35m\uf192   \u001b[36m\uf192   \u001b[37m\uf192 "
    },
    "break"
  ]
}
