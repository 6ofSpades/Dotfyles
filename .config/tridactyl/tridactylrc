" ==============================================================================
" Background Processes, Custom Commands & Autocmds
" ==============================================================================
" The permanent background engine loop
command run_browser_server_loop jsb (async () => { while (true) { let res = await tri.native.run("~/.config/tridactyl/browser_server.sh"); let output = res.content.trim().split(" "); if (output.length < 2) continue; let action = output[0]; let id = parseInt(output[1]); if (action === "switch") { browser.tabs.update(id, {active: true}); } else if (action === "close") { browser.tabs.remove(id); } else if (action === "discard") { browser.tabs.discard(id); } else if (action === "toggle-pin") { browser.tabs.get(id).then(t => browser.tabs.update(id, {pinned: !t.pinned})); } } })()

" Boot the server as soon as Tridactyl starts
autocmd TriStart .* run_browser_server_loop

" Custom Python / TUI Integrations (Pytab)
bind T jsb browser.tabs.query({currentWindow:true}).then(tabs => { const data = JSON.stringify(tabs.map(t => ({id: t.id, index: t.index, title: t.title, url: t.url, pinned: t.pinned, discarded: t.discarded, lastAccessed: t.lastAccessed, active: t.active}))); tri.native.run("kitty -1 --instance-group=pytab --class=pytab -e python3 ~/.config/tridactyl/pytab.py '" + data.replace(/'/g, "'\\''") + "' recent"); })
bind tt jsb browser.tabs.query({currentWindow:true}).then(tabs => { const data = JSON.stringify(tabs.map(t => ({id: t.id, index: t.index, title: t.title, url: t.url, pinned: t.pinned, discarded: t.discarded, lastAccessed: t.lastAccessed, active: t.active}))); tri.native.run("kitty -1 --instance-group=pytab --class=pytab -e python3 ~/.config/tridactyl/pytab.py '" + data.replace(/'/g, "'\\''") + "' index"); })


