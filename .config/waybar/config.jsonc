{
	/*------------
		layout
	------------*/

	"modules-left": [
		"hyprland/submap",
		"custom/left_div#5",
		"hyprland/workspaces",
		"custom/right_div#5",
		"custom/privacydot_cam",
		"custom/privacydot_loc",
		"hyprland/window"
	],

	"modules-center": [
		"hyprland/windowcount",
		"custom/left_div#4",
		//"custom/left_div#3",
		"temperature",
    "disk",
    "custom/left_div#3",
		"memory",
		"custom/left_div#2",
		"cpu",
		"custom/left_inv#1",
		"custom/left_div#1",

		"custom/distro",

		"custom/right_div#1",
		"custom/right_inv#1",
		"clock#time",
		"custom/right_div#2",
		"clock#date",
		"custom/right_div#3",
		"network",
		"bluetooth",
		"custom/virtual_keyboard",
		"custom/right_div#4"
	],

	"modules-right": [
    "mpris",
		"custom/scrolling_mpris",
		"wireplumber#output",
		"custom/mic_status",
    "custom/left_div#4",
    "tray",
		"custom/left_div#3",
    "custom/recording",
    "custom/protonvpn",
		"custom/left_div#7",
		"backlight",
		"battery",
		"custom/left_inv#1",
		"custom/power_menu"
	],

	/*-------------
		options
	-------------*/

	"layer": "top",
	"position": "top",
	"height": 0,
	// "width": 199,
	"margin": 0,
	"margin-top": 0,
	"spacing": 0,
	"mode": "dock",
	"fixed-center": true,
	"reload_style_on_change": true,

	/*-------------
		modules
	-------------*/

  "hyprland/submap": {
    "format": " {}",
    "min-length": 7,
    "max-length": 7,
    "tooltip": false,
    "always-on": true,
    "default-submap": "MAINS"
  },

  "hyprland/workspaces": {
		"format": "{id}",
		"format-icons": {
			"active": "",
			"default": ""
		},
		"persistent-workspaces": {
			"*": 6
		},
		"on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = '-1' })\"",
		"on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = '+1' })\"",
		"cursor": true
	},

  "hyprland/window": {
		"format": "{}",
		"rewrite": {
			"": "Desktop",
			"kitty": "Terminal",
			"zsh": "Terminal",
			"~": "Terminal"
		},
		"icon": false,
		"swap-icon-label": false,
    "tooltip-format": "Title: {title}\nClass: {class}"
	},

	"hyprland/windowcount": {
		"format": "[{}]",
		"swap-icon-label": false,
    "min-length": 3,
    "max-length": 3
	},

  "temperature": {
		"thermal-zone": 2,  // this number should be the CPU temperature
		"critical-threshold": 85,
		"interval": 10,
		"format-critical": "󰀦 {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"󱃃", "󰔏", "󱃂"
		],
		"min-length": 9,
		"max-length": 9,
		"tooltip-format": "Temp in Fahrenheit: {temperatureF}°F"
	},

  "disk": {
    "format": " {specific_free:0.0f}GiB Free",
    "unit": "GiB",
    "path": "/",
    "min-length": 14,
    "max-length": 14,
    "justify": "right"
  },

  "memory": {
		"interval": 10,
		"format": "  {percentage}%",
		"format-warning": "  {percentage}%",
		"format-critical": "  {percentage}%",
		"states": {
			"warning": 75,
			"critical": 90
		},
		"min-length": 8,
		"max-length": 8,
		"tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB"
	},

  "cpu": {
		"interval": 10,
		"format": "  {usage}%",
		"format-warning": "  {usage}%",
		"format-critical": "  {usage}%",
		"min-length": 7,
		"max-length": 7,
		"states": {
			"warning": 75,
			"critical": 90
		},
		"tooltip": true
	},

  "custom/distro": {
		"format": "󰣇",
		"tooltip": false
	},

  "clock#time": {
		"format": "   {:%H:%M}",
		"min-length": 9,
		"max-length": 9,
		"tooltip-format": "Standard Time: {:%I:%M %p}",
    "justify": "left",
    "align": "0"
	},

  "clock#date": {
		"format": "  {:%m-%d}",
		"min-length": 8,
		"max-length": 8,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
		  "mode": "month",
			"mode-mon-col": 3,
			"week-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span alpha='100%'><b>{}</b></span>",
				"days": "<span alpha='90%'>{}</span>",
				"weekdays": "<span alpha='80%'><i>{}</i></span>",
				"today": "<span color='#aa00ffff'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click": "mode"
		}
	},

  "network": {
		"interface": "enp3s0",
		"interval": 30,
		"format": "󰛳 {ipaddr}",
		"format-ethernet": "󰈀 {ipaddr}",
		"format-wifi": "{icon} {essid}",
		"format-disconnected": "󰤯 ",
		"format-disabled": "󰤮 ",
    "format-linked": "󰌘 {ifname} (No IP)",
		"format-icons": ["󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
		"on-click": "kitty -e ~/.config/waybar/scripts/network.sh",
		"on-click-right": "nmcli radio wifi off && notify-send 'Wi-Fi Disabled' -i 'network-wireless-off' -r 1125",
		"tooltip-format": "Gateway: {gwaddr}",
		"tooltip-format-ethernet": "Interface: {ifname}\nGateway: {gwaddr}",
		"tooltip-format-wifi": "Network: {essid}\nIP Addr: {ipaddr}/{cidr}\nStrength: {signalStrength}%\nFrequency: {frequency} GHz\nGateway: {gwaddr}",
		"tooltip-format-disconnected": "Wi-Fi Disconnected",
		"tooltip-format-disabled": "Wi-Fi Disabled",
    "min-length": 18,
    "max-length": 18
	},

  "bluetooth": {
		"format": "󰂯",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-on": "󰂰",
		"format-connected": "󰂱",
		"min-length": 2,
		"max-length": 2,
		"on-click": "kitty -e ~/.config/waybar/scripts/bluetooth.sh",
		"on-click-right": "bluetoothctl power off && notify-send 'Bluetooth Off' -i 'network-bluetooth-inactive' -r 1925",
		"tooltip-format": "Device Addr: {device_address}",
		"tooltip-format-disabled": "Bluetooth Disabled",
		"tooltip-format-off": "Bluetooth Off",
		"tooltip-format-on": "Bluetooth Disconnected",
		"tooltip-format-connected": "Device: {device_alias}",
		"tooltip-format-enumerate-connected": "Device: {device_alias}",
		"tooltip-format-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%",
		"tooltip-format-enumerate-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%"
	},

  "custom/virtual_keyboard": {
		"format": "",
		"min-length": 1,
		"max-length": 1,
		"on-click": "( pkill wvkbd-deskintl && hyprctl eval 'hl.config({ input = { follow_mouse = 1 } })') || ( xargs -a ~/.config/wvkbd/config wvkbd-deskintl & hyprctl eval 'hl.config({ input = { follow_mouse = 2 } })' )",
		"on-click-right": "( pkill wvkbd-deskintl && hyprctl eval 'hl.config({ input = { follow_mouse = 1 } })') || ( xargs -a ~/.config/wvkbd/config wvkbd-deskintl --non-exclusive & hyprctl eval 'hl.config({ input = { follow_mouse = 2 } })' )",
		"tooltip-format": "Left-click to open/close virtual keyboard\nRigth-click to open/close in non-exclusive mode"
	},

  "mpris": {
    "format-playing": "{player_icon}",
    "format-paused": "{status_icon}",
    "format-stopped": "{status_icon}",
    "player-icons": {
      "default": " ",
      "YoutubeMusic": " ",
      "firefox": "󰈹 ",
      "mpv": " "
    },
    "status-icons": {
      "playing": " ",
      "paused": " ",
      "stopped": " ",
    },
		"on-click": "playerctl play-pause",
    // "ignored-players": ["firefox"]
    "justify": "left",
    "align": 0
  },

  "custom/scrolling_mpris": {
		"exec": "python3 -u ~/.config/waybar/scripts/scrolling-mpris.py",
		"return-type": "json",
		"format": "{text}",
    "justify": "left",
    "max-length": 100,
    "tooltip": false, // this is very important, all other module tooltips break if this is true
    "escape": false,
    "markup": "pango"
	},

  "custom/privacydot_cam": {
    "exec": "~/.config/waybar/scripts/privacydots.sh cam",
    "return-type": "json",
    "interval": 3,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "markup": "pango"
  },
  "custom/privacydot_loc": {
    "exec": "~/.config/waybar/scripts/privacydots.sh loc",
    "return-type": "json",
    "interval": 3,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "markup": "pango"
  },

  "custom/recording": {
    "format": "{}",
    "exec-if": "pgrep -x obs",
    "exec": "~/.config/waybar/scripts/obs-status.sh",
    "return-type": "json",
    "interval": 3,
    "hide-empty-text": true,
  },

  "custom/protonvpn": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/vpn-status.sh",
    "return-type": "json",
    "interval": 5,
    "hide-empty-text": true
  },

  "tray": {
    "spacing": 6,
    "icon-size": 14,
    "show-passive-items": true,
    "icons": {
      "flameshot": "/usr/share/icons/candy-icons/apps/scalable/flameshot.svg",
      "qBittorrent": "/usr/share/icons/candy-icons/apps/scalable/qbittorrent.svg",
      "protonvpn-gui": "/usr/share/icons/candy-icons/apps/scalable/protonvpn-gui.svg",
      "spotify-client": "/usr/share/icons/candy-icons/apps/scalable/spotify-client.svg",
      "steam": "/usr/share/icons/candy-icons/apps/scalable/steam.svg",
      "virt-manager": "/usr/share/icons/candy-icons/apps/scalable/virt-manager.svg",
      "/usr/bin/python /usr/bin/solaar": "/usr/share/icons/candy-icons/preferences/scalable/preferences.svg",
      "qpwgraph": "/usr/share/icons/candy-icons/apps/scalable/org.rncbc.qpwgraph.svg",
      "portmaster": "/usr/share/icons/candy-icons/apps/scalable/qpwgraph.svg"
    }
  },

  "group/wireplumber": {
		"orientation": "horizontal",
		"modules": [
			"wireplumber#output",
			"wireplumber#input"
		],
		"drawer": {
			"transition-left-to-right": false
		},
    "justify": "right",
    "align": "1",
	},

	"wireplumber#output": {
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 {volume}%",
		"format-icons": {
			"default": [ "󰕿", "󰖀", "󰕾" ],
		},
		"min-length": 6,
		"max-length": 6,
		"on-click": "kitty --class wiremix wiremix",
		"on-right-click": "~/.config/waybar/scripts/volume.sh output mute",
		"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2.5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2.5%-",
    "tooltip": true,
		"tooltip-format": "Output Device: {desc}"
	},

  "custom/mic_status": {
    "exec": "~/.config/waybar/scripts/mic-status.py",
    // you should define which apps should be ignored directly in the script
    "return-type": "json",
    "format": "{text}",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle 2>/dev/null",
    "hide-empty-text": true,
    "interval": 3,
    "tooltip": true,
    "escape": false,
    "markup": "pango"
  },

	"wireplumber#input": {
		"format": "{format_source}",
		"format-source": "󰍬 {volume}%",
		"format-source-muted": "󰍭 {volume}%",
		"min-length": 6,
		"max-length": 6,
		"on-click": "~/.config/waybar/scripts/volume.sh input mute",
		"on-scroll-up": "~/.config/waybar/scripts/volume.sh input raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume.sh input lower",
		"tooltip-format": "Input Device: {desc}"
	},
  
	"backlight": {
		// "interval":
		"format": "{icon}",
		"format-icons": [
			"", "", "", "", "", "", "", "", ""
		],
		"min-length": 2,
		"max-length": 2,
		// "rotate":
		// "states":
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		"on-scroll-up": "~/.config/waybar/scripts/backlight.sh up",
		"on-scroll-down": "~/.config/waybar/scripts/backlight.sh down",
		// "smooth-scrolling-threshold":
		// "reverse-scrolling":
		// "reverse-mouse-scrolling":
		// "scroll-step":
		"tooltip": false
		// "tooltip-format":
	},

	"battery": {
		// "bat":
		// "adapter":
		// "design-capacity":
		// "full-at":
		// "interval":
		"states": {
			"warning": 20,
			"critical": 10
		},
		"format": "{icon} {capacity}%",
		"format-time": "{H} hr {M} min",
		"format-icons": [
			"󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
		],
		"format-charging": "󰉁 {capacity}%",
		"min-length": 2,
		"max-length": 2,
		// "rotate":
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "Discharging: {time}",
		"tooltip-format-charging": "Charging: {time}",
		// "weighted-average":
		// "bat-compatibility":
		"events": {
			"on-discharging-warning": "notify-send 'Low Battery' '{capacity}% battery remaining'",
			"on-discharging-critical": "notify-send 'Low Battery' '{capacity}% battery remaining' -u critical",
			"on-charging-100": "notify-send 'Battery full' 'Battery is at {capacity}%'"
		}
	},

  "custom/power_menu": {
		"format": "󰤄",
		"on-click": "wlogout",
		"tooltip-format": "Power Menu"
	},


	/*-------------------
		left dividers
	-------------------*/

	"custom/left_div#1": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#2": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#3": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#4": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#5": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#6": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#7": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#8": {
		"format": "",
		"tooltip": false
	},
	"custom/left_inv#1": {
		"format": "",
		"tooltip": false
	},
	"custom/left_inv#2": {
		"format": "",
		"tooltip": false
	},

	/*--------------------
		right dividers
	--------------------*/

	"custom/right_div#1": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#2": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#3": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#4": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#5": {
		"format": "",
		"tooltip": false
	},
	"custom/right_inv#1": {
		"format": "",
		"tooltip": false
	}
	
}
