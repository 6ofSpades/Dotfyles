* {
    bg: rgb(0, 0, 0);
    fg: rgb(192, 202, 245);
    black: rgb(0, 0, 0);
    red: rgb(204, 0, 252);
    green: rgb(0, 191, 151);
    yellow: rgb(224, 175, 104);
    blue: rgb(48, 58, 255);
    magenta: rgb(133, 0, 188);
    cyan: rgb(0, 255, 255);
    white: rgb(221, 221, 221);
    black-bright: rgb(65, 74, 116);
    red-bright: rgb(204, 0, 252);
    green-bright: rgb(0, 191, 151);
    yellow-bright: rgb(224, 175, 104);
    blue-bright: rgb(48, 58, 255);
    magenta-bright: rgb(133, 0, 188);
    cyan-bright: rgb(0, 255, 255);
    white-bright: rgb(255, 255, 255);
    gray0: rgb(30, 30, 30);
    gray1: rgb(22, 22, 38);
    gray2: rgb(97, 106, 148);
    magenta2: rgb(154, 40, 227);
    magenta3: rgb(95, 0, 247);
    accent: rgb(105, 16, 165);
    accent-darker: rgb(41, 3, 85);
    accent-lighter: rgb(239, 174, 255);
    cursor: rgb(105, 16, 165);
    cursor-text-color: rgb(221, 221, 221);
    cursor-line: rgb(41, 3, 85);
    cursor-line-number: rgb(0, 255, 255);
    line-number: rgb(65, 74, 116);
    selection-bg: rgb(73, 3, 117);
    rofi-bg: rgba(0,0,0,0.5);
    frecency-bg: rgba(0,0,0,0.3);
    rofi-border: rgb(105,16,165);
    selected-bg: rgba(41,3,85,0.4);
    active-fg: rgb(133,0,188);
}