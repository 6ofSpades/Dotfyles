#!/usr/bin/env python3
"""Tickloom: a small, keyboard-driven terminal stopwatch and countdown."""
from __future__ import annotations

import argparse
import curses
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import time
import tomllib

# Change these defaults here, or edit ~/.config/tickloom/config.toml.
DEFAULT_CONFIG = '''# Tickloom configuration (restart after editing).
[font]
mode = "figlet" # "figlet" or "ttf"
figlet = "big" # Built-in name or full path to a .flf/.tlf file
# Empty selects an installed DejaVu/Liberation monospace font.
ttf = ""
size = 32 # TTF pixel height; adjustable with = and -

[keys]
start_pause = "SPACE"
reset = "r"
input = "/"
switch_mode = "TAB"
grow = "="
shrink = "-"
stop_alarm = "a"
quit = "q"

[colors]
normal = "cyan"
paused = "yellow"
finished = "red"
footer_key = "cyan"
footer_separator = "white"
footer_action = "white"
footer_section_separator = "white"
status = "white"
input = "yellow"

[footer]
separator = " -> "
section_separator = " . "

[alarm]
enabled = false
file = "" # Absolute path to an audio file, e.g. /home/me/alarm.mp3
# Optional player command array. {file} is replaced with the audio path.
# Empty automatically selects ffplay, mpv, paplay, or aplay.
command = []
'''


def parse_duration(value: str) -> float:
    """Accept 10m, 1h 5m 30s, or a plain number of seconds."""
    value = value.strip().lower()
    if re.fullmatch(r'\d+(?:\.\d+)?', value):
        seconds = float(value)
    else:
        pattern = r'(\d+(?:\.\d+)?)\s*([hms])'
        parts = list(re.finditer(pattern, value))
        if not parts or re.sub(pattern, '', value).strip():
            raise ValueError('Use 10m, 2h, 1h 5m 30s, or seconds.')
        seconds = sum(float(m[1]) * {'h': 3600, 'm': 60, 's': 1}[m[2]] for m in parts)
    if not math.isfinite(seconds) or not 0 < seconds <= 359999:
        raise ValueError('Duration must be positive and at most 99h 59m 59s.')
    return seconds


def format_time(seconds: float, countdown: bool = False) -> str:
    total = max(0, math.ceil(seconds) if countdown else int(seconds))
    hours, remainder = divmod(total, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f'{hours:02d}:{minutes:02d}:{seconds:02d}'


class Timer:
    def __init__(self):
        self.countdown = False
        self.duration = 0.0
        self.elapsed = 0.0
        self.started = None
        self.finished = False

    def elapsed_at(self, now):
        return self.elapsed + (now - self.started if self.started is not None else 0)

    def value(self, now):
        elapsed = self.elapsed_at(now)
        return max(0, self.duration - elapsed) if self.countdown else elapsed

    def reset(self):
        self.elapsed, self.started, self.finished = 0.0, None, False

    def toggle(self, now):
        if self.started is not None:
            self.elapsed = self.elapsed_at(now)
            self.started = None
        else:
            if self.finished:
                self.reset()
            self.started = now

    def tick(self, now):
        if self.countdown and self.started is not None and self.value(now) <= 0:
            self.elapsed, self.started, self.finished = self.duration, None, True
            return True
        return False


class Alarm:
    def __init__(self, config):
        self.config = config
        self.active = False
        self.process = None
        self.command = None

    def start(self):
        if not self.config['enabled']:
            return ''
        path = Path(self.config['file']).expanduser()
        if not path.is_file():
            return 'Alarm file does not exist; edit [alarm].file.'
        command = self.config['command']
        if command:
            self.command = [part.replace('{file}', str(path)) for part in command]
        else:
            for player, args in [('ffplay', ['-nodisp', '-autoexit', '-loglevel', 'quiet']),
                                 ('mpv', ['--no-video', '--really-quiet']),
                                 ('paplay', []), ('aplay', [])]:
                if shutil.which(player):
                    self.command = [player, *args, str(path)]
                    break
        if not self.command:
            return 'No audio player found. Install ffmpeg or mpv.'
        self.active = True
        return self.poll()

    def poll(self):
        if self.active and (self.process is None or self.process.poll() is not None):
            if self.process is not None and self.process.returncode != 0:
                self.active = False
                return 'Audio player failed; check the file and player configuration.'
            try:
                self.process = subprocess.Popen(self.command, stdin=subprocess.DEVNULL,
                                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as exc:
                self.active = False
                return f'Cannot play alarm: {exc}'
        return ''

    def stop(self):
        self.active = False
        if self.process is not None and self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait()
        self.process = None


class Renderer:
    def __init__(self, config):
        self.config = config
        self.size = max(8, min(200, int(config['size'])))
        self.cache = {}
        if config['mode'] not in ('ttf', 'figlet'):
            raise ValueError('font.mode must be figlet or ttf')
        if config['mode'] == 'figlet':
            import pyfiglet
            font_name = config['figlet']
            path = Path(font_name).expanduser()
            if path.is_file():
                # Load the exact file: pyfiglet's normal loader appends an extension.
                class FileFont(pyfiglet.FigletFont):
                    @classmethod
                    def preloadFont(cls, font):
                        import zipfile
                        if zipfile.is_zipfile(path):
                            with zipfile.ZipFile(path) as archive:
                                data = archive.read(archive.namelist()[0])
                        else:
                            data = path.read_bytes()
                        return data.decode('utf-8', 'replace')
                self.figlet = pyfiglet.Figlet(width=10000)
                self.figlet.Font = FileFont(font=str(path))
            else:
                if path.suffix.lower() in ('.flf', '.tlf') or '/' in font_name:
                    raise ValueError(f'FIGlet font file does not exist: {path}')
                self.figlet = pyfiglet.Figlet(font=font_name, width=10000)
        else:
            from PIL import Image, ImageDraw, ImageFont
            self.Image, self.ImageDraw, self.ImageFont = Image, ImageDraw, ImageFont
            candidates = [config['ttf']] if config['ttf'] else [
                '/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf',
                '/usr/share/fonts/truetype/liberation2/LiberationMono-Regular.ttf',
                '/usr/share/fonts/liberation/LiberationMono-Regular.ttf',
                '/System/Library/Fonts/Menlo.ttc']
            self.path = next((str(Path(p).expanduser()) for p in candidates if Path(p).expanduser().is_file()), None)
            if not self.path:
                raise ValueError('Set font.ttf to the path of a TTF/OTF font.')

    def resize(self, delta):
        self.size = max(8, min(200, self.size + delta))
        self.cache.clear()

    def render(self, text):
        key = (text, self.size)
        if key in self.cache:
            return self.cache[key]
        if self.config['mode'] == 'figlet':
            lines = self.figlet.renderText(text).rstrip('\n').splitlines()
            # FIGlet has discrete sizes; scale its bitmap with nearest-neighbor sampling.
            scale = self.size / 32
            width = max(map(len, lines))
            lines = [line.ljust(width) for line in lines]
            lines = [''.join(lines[min(len(lines)-1, int(y/scale))][min(width-1, int(x/scale))]
                             for x in range(max(1, round(width*scale))))
                     for y in range(max(1, round(len(lines)*scale)))]
        else:
            font = self.ImageFont.truetype(self.path, self.size)
            box = font.getbbox(text)
            bitmap = self.Image.new('L', (max(1, box[2]-box[0]), max(1, box[3]-box[1])), 0)
            self.ImageDraw.Draw(bitmap).text((-box[0], -box[1]), text, font=font, fill=255)
            # Two vertical pixels per terminal cell preserve font proportions.
            pixels = bitmap.load()
            lines = [''.join(' ▀▄█'[(1 if pixels[x,y] >= 100 else 0) |
                                  (2 if y+1 < bitmap.height and pixels[x,y+1] >= 100 else 0)]
                             for x in range(bitmap.width)) for y in range(0, bitmap.height, 2)]
        if len(self.cache) > 32:
            self.cache.clear()
        self.cache[key] = lines
        return lines


def load_config(path):
    import copy
    defaults = tomllib.loads(DEFAULT_CONFIG)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        with path.open('x') as file:
            file.write(DEFAULT_CONFIG)
    except FileExistsError:
        pass
    with path.open('rb') as file:
        user = tomllib.load(file)
    config = copy.deepcopy(defaults)
    for section, values in user.items():
        if section in config:
            config[section].update(values)
    keys = list(config['keys'].values())
    if any(not isinstance(k, str) or not (len(k) == 1 or k in ('SPACE', 'TAB', 'ESC', 'ENTER')) for k in keys):
        raise ValueError('Keys must be one character or SPACE, TAB, ESC, ENTER.')
    if len(set(normalize_key(k) for k in keys)) != len(keys):
        raise ValueError('Each action needs a distinct key.')
    return config


def normalize_key(key):
    return {'SPACE': ' ', 'TAB': '\t', 'ESC': '\x1b', 'ENTER': '\n'}.get(key, key)


def nearest_color(rgb, palette):
    """Find the closest supported color when the terminal has a fixed palette."""
    return min(range(len(palette)), key=lambda i: sum((a-b)**2 for a, b in zip(rgb, palette[i])))


def run(screen, config, renderer):
    curses.curs_set(0)
    screen.timeout(100)
    colors = {}
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        palette = {name: getattr(curses, 'COLOR_' + name.upper()) for name in
                   ('black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white')}
        palette['default'] = -1
        custom_colors = {}
        for index, (role, name) in enumerate(config['colors'].items(), 1):
            if name in palette:
                color = palette[name]
            elif isinstance(name, str) and re.fullmatch(r'#[0-9a-fA-F]{6}', name):
                rgb = tuple(round(int(name[i:i+2], 16) * 1000 / 255) for i in (1, 3, 5))
                if name in custom_colors:
                    color = custom_colors[name]
                else:
                    slot = 16 + len(custom_colors)
                    if curses.can_change_color() and slot < curses.COLORS:
                        curses.init_color(slot, *rgb)
                        color = slot
                    else:
                        color = nearest_color(rgb, [curses.color_content(c) for c in range(curses.COLORS)])
                    custom_colors[name] = color
            else:
                raise ValueError(f'Unknown color {name!r}; use a terminal color, default, or #RRGGBB.')
            curses.init_pair(index, color, -1)
            colors[role] = curses.color_pair(index)
    def put(y, x, text, role='status'):
        h, w = screen.getmaxyx()
        if 0 <= y < h and x < w:
            if x < 0:
                text, x = text[-x:], 0
            try:
                screen.addstr(y, x, text[:max(0, w-x-1)], colors.get(role, 0))
            except curses.error:
                pass

    timer, alarm = Timer(), Alarm(config['alarm'])
    keys = {normalize_key(key): action for action, key in config['keys'].items()}
    editing, entry, message = False, '', ''
    try:
        while True:
            now = time.monotonic()
            if timer.tick(now):
                message = alarm.start()
            message = alarm.poll() or message
            screen.erase()
            h, w = screen.getmaxyx()
            state = 'FINISHED' if timer.finished else ('RUNNING' if timer.started is not None else ('PAUSED' if timer.elapsed else 'READY'))
            put(0, 1, f'Tickloom | {"COUNTDOWN" if timer.countdown else "STOPWATCH"} | {state} | size {renderer.size}')
            lines = renderer.render(format_time(timer.value(now), timer.countdown))
            width = max(map(len, lines), default=0)
            role = 'finished' if timer.finished else ('paused' if timer.started is None else 'normal')
            top = max(1, (h-4-len(lines))//2+1)
            for offset, line in enumerate(lines):
                if top+offset < h-3:
                    put(top+offset, (w-width)//2, line, role)
            if width > w-1 or len(lines) > h-4:
                message = 'Display clipped: shrink with ' + config['keys']['shrink'] + ' or enlarge the terminal.'
            elif message.startswith('Display clipped:'):
                message = ''
            put(h-3, 0, ('Duration: ' + entry + '  [Enter: apply, Esc: cancel]') if editing else message,
                'input' if editing else 'status')
            actions = [('start_pause', 'start/pause'), ('reset', 'reset'), ('input', 'countdown'),
                       ('switch_mode', 'mode'), ('grow', 'grow'), ('shrink', 'shrink'),
                       ('stop_alarm', 'stop alarm'), ('quit', 'quit')]
            y, x = h-2, 0
            for action, label in actions:
                segments = [(config['keys'][action], 'footer_key'), (config['footer']['separator'], 'footer_separator'), (label, 'footer_action')]
                divider = config['footer']['section_separator'] if x else ''
                length = sum(len(s) for s, _ in segments)
                if x and x+len(divider)+length >= w:
                    y, x, divider = y+1, 0, ''
                put(y, x, divider, 'footer_section_separator')
                x += len(divider)
                for text, color in segments:
                    put(y, x, text, color)
                    x += len(text)
            screen.refresh()
            try:
                key = screen.get_wch()
            except curses.error:
                continue
            if editing:
                if key in ('\n', '\r', curses.KEY_ENTER):
                    try:
                        duration = parse_duration(entry)
                    except ValueError as exc:
                        message = str(exc)
                        editing = False
                    else:
                        alarm.stop()
                        timer.reset()
                        timer.duration, timer.countdown = duration, True
                        editing, message = False, ''
                elif key == '\x1b':
                    editing = False
                elif key in ('\b', '\x7f', curses.KEY_BACKSPACE):
                    entry = entry[:-1]
                elif isinstance(key, str) and key.isprintable() and len(entry) < 80:
                    entry += key
                continue
            action = keys.get(key)
            if action == 'quit':
                break
            if action == 'start_pause':
                alarm.stop()
                timer.toggle(time.monotonic())
            elif action == 'reset':
                alarm.stop()
                timer.reset()
            elif action == 'switch_mode':
                alarm.stop()
                timer.reset()
                timer.countdown = not timer.countdown if timer.duration else False
                message = '' if timer.duration else 'Press '+config['keys']['input']+' to choose a countdown first.'
            elif action == 'input':
                editing, entry, message = True, '', ''
            elif action in ('grow', 'shrink'):
                renderer.resize(2 if action == 'grow' else -2)
            elif action == 'stop_alarm':
                alarm.stop()
    finally:
        alarm.stop()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, default=Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))/'tickloom'/'config.toml')
    args = parser.parse_args()
    try:
        config = load_config(args.config.expanduser())
        renderer = Renderer(config['font'])
        curses.wrapper(run, config, renderer)
    except (ValueError, OSError, ImportError, curses.error) as exc:
        parser.exit(1, f'Tickloom: {exc}\nInstall dependencies with: pip install -r requirements.txt\n')
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
