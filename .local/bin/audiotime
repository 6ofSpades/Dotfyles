#!/usr/bin/env python3

import glob
import json
import os
import subprocess
import sys


def get_duration(file_path):
    """Extract duration in seconds using mediainfo JSON output."""
    try:
        cmd = ["mediainfo", "--Output=JSON", file_path]
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        data = json.loads(result.stdout)

        # Look for the duration in the 'General' track first
        for track in data.get("media", {}).get("track", []):
            if track.get("@type") == "General" and "Duration" in track:
                return float(track["Duration"])

        # Fallback: sum audio tracks if General duration is missing
        total_audio_duration = 0.0
        for track in data.get("media", {}).get("track", []):
            if track.get("@type") == "Audio" and "Duration" in track:
                total_audio_duration += float(track["Duration"])
        return total_audio_duration

    except (subprocess.CalledProcessError, json.JSONDecodeError, ValueError):
        print(f"Warning: Could not read metadata for '{file_path}'", file=sys.stderr)
        return 0.0


def main():
    if len(sys.argv) < 2:
        print(
            "Description: Calculates the total duration of media files using mediainfo."
        )
        print("Usage: audiotime <file1> [file2 ...] or audiotime '*'")
        sys.exit(1)

    # Expand any wildcards passed manually (helpful if passing strings like '*')
    file_args = sys.argv[1:]
    expanded_files = []
    for arg in file_args:
        matched = glob.glob(arg)
        if matched:
            expanded_files.extend(matched)
        else:
            expanded_files.append(arg)

    # Filter out directories and non-existent files
    files = [f for f in expanded_files if os.path.isfile(f)]

    if not files:
        print("No valid files found.", file=sys.stderr)
        sys.exit(1)

    total_seconds = 0.0
    processed_count = 0

    for f in files:
        dur = get_duration(f)
        if dur > 0:
            total_seconds += dur
            processed_count += 1

    # Format output
    s = total_seconds
    hours = int(s // 3600)
    minutes = int((s % 3600) // 60)
    seconds = s % 60

    print(f"\nProcessed {processed_count} files.")
    if hours > 0:
        print(
            f"Total Time: {hours:02d}:{minutes:02d}:{seconds:05.2f} ({total_seconds:.2f} seconds)"
        )
    else:
        print(
            f"Total Time: {minutes:02d}:{seconds:05.2f} ({total_seconds:.2f} seconds)"
        )


if __name__ == "__main__":
    main()
