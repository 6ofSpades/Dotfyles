#!/usr/bin/env bash

# This little script should help if you don't remember
# the millions of commands in yt-dlp

# set -e
set -o pipefail

# Colors
RED=$(kitty @ get-colors | awk '$1 == "color1" {print $2}')
GREEN=$(kitty @ get-colors | awk '$1 == "color2" {print $2}')
CYAN=$(kitty @ get-colors | awk '$1 == "color6" {print $2}')
MAGENTA=$(kitty @ get-colors | awk '$1 == "color5" {print $2}')

TITLE_COLOR="$CYAN"
ACCENT_COLOR="$MAGENTA"

clear

gum style \
  --foreground "$TITLE_COLOR" \
  --border-foreground "$ACCENT_COLOR" \
  --border double \
  --padding "1 4" \
  --margin "0 1" \
  --align center \
  "󰿏 YTUI 󰿏" "YT-DLP FOR SHORT MEMORY PEOPLE"
gum style \
  --foreground "#fff" \
  --margin "1 0" \
  "P.S.: Not truly TUI, but definitely useful if you can't remember yt-dlp commands 😅"

while true; do
  URL=$(
    gum input --placeholder "Paste URL here" \
      --header "
    Enter q to quit
    Enter ? to see all supported sites
    "
  )

  [ -z "$URL" ] && exit 1
  [ "$URL" == "q" ] && exit 0
  [ "$URL" == "?" ] && curl https://raw.githubusercontent.com/yt-dlp/yt-dlp/refs/heads/master/supportedsites.md | gum format | gum pager --match.foreground="$MAGENTA" && continue
  break
done

TYPE=$(gum choose \
  --header "Choose type" \
  "  Video (mp4)" \
  "  Video (mkv)" \
  "  Audio (mp3)" \
  "  Audio (flac)"
)

# -------------------------
# Type-specific prompts
# -------------------------

case "$TYPE" in
  "  Video (mp4)"|"  Video (mkv)")

    RESOLUTION=$(gum choose \
      --header "
      Choose desired resolution.
      Will fall back to lower if selected resolution is not available
      " \
      "Auto Best" \
      "1080p" \
      "720p" \
      "480p"
      "360p"
    )

    AUDIO_QUALITY=$(gum choose \
      --header "Choose audio quality" \
      "Auto Best" \
      "≤320k" \
      "≤192k" \
      "≤128k"
    )
    ;;

  "  Audio (mp3)"|"  Audio (flac)")

    AUDIO_QUALITY=$(gum choose \
      --header "Choose audio quality" \
      "Auto Best" \
      "≤320k" \
      "≤192k" \
      "≤128k"
    )
    ;;
esac

# -------------------------

COOKIE_CHOICE=$(gum choose \
  --header " Cookies" \
  "No Cookies" \
  "Firefox" \
  "Chromium" \
  "Brave" \
  "Custom Browser"
)

EXTRA_OPTIONS=$(gum choose --no-limit \
  --header "Extras" \
  "Embed Metadata" \
  "Embed Thumbnail" \
  "Download Subtitles" \
  "Download Playlist"
)

FOLDER=$(gum input --placeholder "Download folder (default: ~/Videos)")

[ -z "$FOLDER" ] && FOLDER="$HOME/Videos"

mkdir -p "$FOLDER"

# -----------------------------------
# Build yt-dlp command dynamically
# -----------------------------------

CMD="yt-dlp"

# Cookies
case "$COOKIE_CHOICE" in
  "Firefox")
    CMD="$CMD --cookies-from-browser firefox"
    ;;
  "Chromium")
    CMD="$CMD --cookies-from-browser chromium"
    ;;
  "Brave")
    CMD="$CMD --cookies-from-browser brave"
    ;;
  "Custom Browser")
    CUSTOM_HEADER="
    E.g. For Zen-Browser: firefox:~/.zen/
    Works cause Zen is a fork of Firefox and that's the path to Zen's folder
    "
    BROWSER=$(gum input --header "$CUSTOM_HEADER" --placeholder "Enter <browser_name:path to folder>")
    CMD="$CMD --cookies-from-browser $BROWSER"
    ;;
esac

# Output organization
CMD="$CMD -P \"$FOLDER\" -o \"%(title)s.%(ext)s\""

# Metadata
[[ "$EXTRA_OPTIONS" == *"Embed Metadata"* ]] && CMD="$CMD --embed-metadata"
[[ "$EXTRA_OPTIONS" == *"Embed Thumbnail"* ]] && CMD="$CMD --embed-thumbnail"
[[ "$EXTRA_OPTIONS" == *"Download Subtitles"* ]] && CMD="$CMD --write-auto-subs --sub-lang en --embed-subs"
[[ "$EXTRA_OPTIONS" != *"Download Playlist"* ]] && CMD="$CMD --no-playlist"


case "$AUDIO_QUALITY" in
  "Auto Best")
    AUDIO_FORMAT="bestaudio"
    ;;
  "≤320k")
    AUDIO_FORMAT="bestaudio[abr<=320]"
    ;;
  "≤192k")
    AUDIO_FORMAT="bestaudio[abr<=192]"
    ;;
  "≤128k")
    AUDIO_FORMAT="bestaudio[abr<=128]"
    ;;
esac

# Type handling
case "$TYPE" in

  "  Audio (mp3)")
    CMD="$CMD -f \"$AUDIO_FORMAT\" -x --audio-format mp3"
    ;;

  "  Audio (flac)")
    CMD="$CMD -f \"$AUDIO_FORMAT\" -x --audio-format flac"
    ;;

  *)

    case "$TYPE" in
      "  Video (mp4)")
        MERGE="--merge-output-format mp4"
        ;;
      "  Video (mkv)")
        MERGE="--merge-output-format mkv"
        ;;
    esac

    case "$RESOLUTION" in
      "Auto Best")
        FORMAT="bv*+ba/b"
        ;;
      "1080p")
        FORMAT="bestvideo[height<=1080]+$AUDIO_FORMAT/best[height<=1080]"
        ;;
      "720p")
        FORMAT="bestvideo[height<=720]+$AUDIO_FORMAT/best[height<=720]"
        ;;
      "480p")
        FORMAT="bestvideo[height<=480]+$AUDIO_FORMAT/best[height<=480]"
        ;;
    esac

    CMD="$CMD -f \"$FORMAT\" $MERGE"
    ;;
esac

CMD="$CMD \"$URL\""

# -----------------------------------
# Execute with spinner
# -----------------------------------

gum spin \
  --spinner minidot \
  --title "Downloading..." \
  --show-error \
  -- bash -c "$CMD"

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  gum style \
    --foreground "$RED" \
    --bold \
    --padding "1 1" \
    "❌ Download Failed"
  exit 1
fi

gum style \
  --foreground "$GREEN" \
  --bold \
  "✔ Download Complete!"
