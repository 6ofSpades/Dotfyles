#!/usr/bin/env python3

import sys


def swap_rgba_argb(value: str) -> str:
    prefix = ""

    if value.startswith("#"):
        prefix = "#"
        value = value[1:]

    if len(value) != 8:
        raise ValueError("Input must be 8 hex characters (RRGGBBAA or AARRGGBB).")

    # RGBA -> ARGB or ARGB -> RGBA
    # move last two bytes to front
    converted = value[6:8] + value[0:6]

    return prefix + converted


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: rgba2argb <hexcolor>")
        print()
        print("Examples:")
        print("  rgba2argb #FFAA00")
        sys.exit(1)

    print(swap_rgba_argb(sys.argv[1]))
